\@writefile{lot}{\contentsline {table}{\numberline {3.4}{\ignorespaces Inertial noise parameters supplied to the visual-inertial estimators, beside the values measured from the recorded IMU stream in \cref  {sec:proprio-method}. The configured values are inherited estimator defaults, not measurements of this simulated IMU; the discrepancy is carried forward as a queried item rather than silently reconciled.}}{7}{table.3.4}\protected@file@percent }
\newlabel{tab:imu-noise-assumed}{{3.4}{7}{Inertial noise parameters supplied to the visual-inertial estimators, beside the values measured from the recorded IMU stream in \cref {sec:proprio-method}. The configured values are inherited estimator defaults, not measurements of this simulated IMU; the discrepancy is carried forward as a queried item rather than silently reconciled}{table.3.4}{}}
