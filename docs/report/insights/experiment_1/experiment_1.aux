\@writefile{lot}{\contentsline {table}{\numberline {1.2}{\ignorespaces Estimator comparison on the five \texttt  {allsensor} bags. Bold marks the best aligned ATE of each bag \emph  {as each system was configured}. Visual estimators are scored at the IMU point, baselines at the model origin (see Reporting rules). The \emph  {EKF @ VSLAM noise} rows are the same filter with only its four IMU noise terms replaced by the values of \texttt  {config/wil_sim/stereo_imu.yaml}, the file every visual run read. Drift is final position error over distance driven.\relax }}{3}{table.caption.7}\protected@file@percent }
\newlabel{tab:e1-accuracy}{{1.2}{3}{Estimator comparison on the five \repo {allsensor} bags. Bold marks the best aligned ATE of each bag \emph {as each system was configured}. Visual estimators are scored at the IMU point, baselines at the model origin (see Reporting rules). The \emph {EKF @ VSLAM noise} rows are the same filter with only its four IMU noise terms replaced by the values of \repo {config/wil_sim/stereo_imu.yaml}, the file every visual run read. Drift is final position error over distance driven.\relax }{table.caption.7}{}}
\newlabel{tab:e1-accuracy@cref}{{[table][2][4]1.2}{[1][2][]3}}
\@writefile{lot}{\contentsline {table}{\numberline {1.3}{\ignorespaces Relative pose error at $\Delta =\SI {1}{\second }$, no alignment, pairs spanning a step above \SI {10}{\metre \per \second } excluded (``clean''). Jumps are the number of such steps. ORB-SLAM3's one to six jumps are its gravity re-alignment at inertial initialisation, which carries about \SI {90}{\degree } of rotation and no translation; with them included its rotational RPE reads \SIrange {8.8}{10.5}{\degree }.\relax }}{3}{table.caption.9}\protected@file@percent }
\newlabel{tab:e1-rpe}{{1.3}{3}{Relative pose error at $\Delta =\SI {1}{\second }$, no alignment, pairs spanning a step above \SI {10}{\metre \per \second } excluded (``clean''). Jumps are the number of such steps. ORB-SLAM3's one to six jumps are its gravity re-alignment at inertial initialisation, which carries about \SI {90}{\degree } of rotation and no translation; with them included its rotational RPE reads \SIrange {8.8}{10.5}{\degree }.\relax }{table.caption.9}{}}
\newlabel{tab:e1-rpe@cref}{{[table][3][4]1.3}{[1][2][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Every estimator on every \texttt  {allsensor} recording, world frame, on the warehouse plan. The baselines are drawn as estimated from the ground-truth start pose; the visual estimators after the rigid $SE(3)$ alignment used for their metrics. The ground-truth line is the model-origin path, so the visual estimates, which follow the IMU, sit up to \SI {0.34}{\metre } from it by construction. The wheel-odometry bow and the IMU's departure from the building recur on all five; the one visual outlier is ORB-SLAM3 with loop closure on \texttt  {allsensor_003}.\relax }}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:e1-grid}{{1.1}{4}{Every estimator on every \repo {allsensor} recording, world frame, on the warehouse plan. The baselines are drawn as estimated from the ground-truth start pose; the visual estimators after the rigid $SE(3)$ alignment used for their metrics. The ground-truth line is the model-origin path, so the visual estimates, which follow the IMU, sit up to \SI {0.34}{\metre } from it by construction. The wheel-odometry bow and the IMU's departure from the building recur on all five; the one visual outlier is ORB-SLAM3 with loop closure on \repo {allsensor_003}.\relax }{figure.caption.8}{}}
\newlabel{fig:e1-grid@cref}{{[figure][1][4]1.1}{[1][2][]4}}
\@writefile{lot}{\contentsline {table}{\numberline {1.4}{\ignorespaces Covariance consistency of the non-visual estimators. A consistent filter gives $\mathrm  {ANEES}=3.0$ and coverages of 0.683, 0.954 and 0.997. Neither visual estimator writes a pose covariance, so neither can be tested. The $\chi ^2$ test runs on a \SI {1}{\hertz } subsample (81 to 102 samples per bag); the coverage columns make no independence assumption and are the sturdier statement.\relax }}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:e1-covariance}{{1.4}{5}{Covariance consistency of the non-visual estimators. A consistent filter gives $\mathrm {ANEES}=3.0$ and coverages of 0.683, 0.954 and 0.997. Neither visual estimator writes a pose covariance, so neither can be tested. The $\chi ^2$ test runs on a \SI {1}{\hertz } subsample (81 to 102 samples per bag); the coverage columns make no independence assumption and are the sturdier statement.\relax }{table.caption.10}{}}
\newlabel{tab:e1-covariance@cref}{{[table][4][4]1.4}{[1][2][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Error against claimed uncertainty on \texttt  {dataset_allsensor_001}. Top left: position error over time. Top right and bottom right: absolute error against the estimator's own $3\sigma $ bound in $x$ and in heading; a solid line above the dashed line of the same colour is overconfidence. Bottom left: NEES against the consistent value of 3. The step near \SI {9.5}{\second } in every panel is the first turn.\relax }}{5}{figure.caption.11}\protected@file@percent }
\newlabel{fig:e1-covariance}{{1.2}{5}{Error against claimed uncertainty on \repo {dataset_allsensor_001}. Top left: position error over time. Top right and bottom right: absolute error against the estimator's own $3\sigma $ bound in $x$ and in heading; a solid line above the dashed line of the same colour is overconfidence. Bottom left: NEES against the consistent value of 3. The step near \SI {9.5}{\second } in every panel is the first turn.\relax }{figure.caption.11}{}}
\newlabel{fig:e1-covariance@cref}{{[figure][2][4]1.2}{[1][2][]5}}
\@writefile{lot}{\contentsline {table}{\numberline {1.5}{\ignorespaces Which IMU noise term costs the EKF its accuracy. Each row moves one term from its measured value to the one \texttt  {config/wil_sim/stereo_imu.yaml} declares, averaged over the five bags. The last row reproduces the gyroscope term's effect on the measurement noise $R$ only, leaving the process noise $Q$ measured: it is harmless, so the damage is entirely through $Q$.\relax }}{6}{table.caption.13}\protected@file@percent }
\newlabel{tab:e1-ablation}{{1.5}{6}{Which IMU noise term costs the EKF its accuracy. Each row moves one term from its measured value to the one \repo {config/wil_sim/stereo_imu.yaml} declares, averaged over the five bags. The last row reproduces the gyroscope term's effect on the measurement noise $R$ only, leaving the process noise $Q$ measured: it is harmless, so the damage is entirely through $Q$.\relax }{table.caption.13}{}}
\newlabel{tab:e1-ablation@cref}{{[table][5][4]1.5}{[1][2][]6}}
\@writefile{lot}{\contentsline {table}{\numberline {1.6}{\ignorespaces EKF aligned ATE with an in-sample and an out-of-sample noise model. Mean change about $-10\,\%$: no systematic in-sample advantage.\relax }}{6}{table.caption.14}\protected@file@percent }
\newlabel{tab:e1-xval}{{1.6}{6}{EKF aligned ATE with an in-sample and an out-of-sample noise model. Mean change about $-10\,\%$: no systematic in-sample advantage.\relax }{table.caption.14}{}}
\newlabel{tab:e1-xval@cref}{{[table][6][4]1.6}{[1][6][]6}}
\@writefile{lot}{\contentsline {table}{\numberline {1.7}{\ignorespaces Wheel-odometry heading drift against the fitted yaw-rate scale. ``Rotation'' is the total unsigned ground-truth rotation of the run. The last column is the mean yaw-rate residual of the run multiplied by its duration.\relax }}{7}{table.caption.15}\protected@file@percent }
\newlabel{tab:e1-h1}{{1.7}{7}{Wheel-odometry heading drift against the fitted yaw-rate scale. ``Rotation'' is the total unsigned ground-truth rotation of the run. The last column is the mean yaw-rate residual of the run multiplied by its duration.\relax }{table.caption.15}{}}
\newlabel{tab:e1-h1@cref}{{[table][7][4]1.7}{[1][7][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {1.8}{\ignorespaces The EKF's heading error follows the quality of the wheel yaw rate it uses to observe its gyroscope bias.\relax }}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:e1-coupling}{{1.8}{7}{The EKF's heading error follows the quality of the wheel yaw rate it uses to observe its gyroscope bias.\relax }{table.caption.16}{}}
\newlabel{tab:e1-coupling@cref}{{[table][8][4]1.8}{[1][7][]7}}
