\@writefile{lot}{\contentsline {table}{\numberline {3.5}{\ignorespaces Extreme world, filtered arms: every run outside the September repeat set, one row each (October 2026, replay rate 1.0, live detector). ``Match'' is \texttt  {detection_match_rate}; a run below 0.98 did not filter on every frame. ``Kept'' is the processed fraction of received frames. Loop-closer state is read from the log. ``Overlap'' is the span over which estimate and ground truth coexist, against the recording's length; a run covering less than \SI {80}{\percent } of it is a partial run and its ATE describes only that span. These runs are reported on their own, not as pairs: their baselines are the September repeats of \cref  {tab:extreme-accuracy-best}, a different session and node build.\relax }}{5}{table.caption.17}\protected@file@percent }
\newlabel{tab:extreme-filtered}{{3.5}{5}{Extreme world, filtered arms: every run outside the September repeat set, one row each (October 2026, replay rate 1.0, live detector). ``Match'' is \repo {detection_match_rate}; a run below 0.98 did not filter on every frame. ``Kept'' is the processed fraction of received frames. Loop-closer state is read from the log. ``Overlap'' is the span over which estimate and ground truth coexist, against the recording's length; a run covering less than \SI {80}{\percent } of it is a partial run and its ATE describes only that span. These runs are reported on their own, not as pairs: their baselines are the September repeats of \cref {tab:extreme-accuracy-best}, a different session and node build.\relax }{table.caption.17}{}}
