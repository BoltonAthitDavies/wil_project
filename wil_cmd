# terminal 4 (rtab vins) -- 3 modes, only this line changes

# BUILD a new map   (your command, with a real filename so it can't eat map/rtabmap.db)
ros2 launch ./rtabmap_ros/rtab_sim.launch.py mode:=construct rviz:=true grid_range_max:=8.0 detection_rate:=4.0 shim_rate:=4.0 output_path:=trash/ database_path:=map/tiny_new.db

# ADD to that map   (relocalizes into it, then keeps mapping)
ros2 launch ./rtabmap_ros/rtab_sim.launch.py mode:=extend rviz:=true grid_range_max:=8.0 detection_rate:=4.0 shim_rate:=4.0 output_path:=trash/ database_path:=map/tiny_new.db

# USE that map, read-only   (no mapping, just "where am I")
ros2 launch ./rtabmap_ros/rtab_sim.launch.py mode:=localize read_only:=true rviz:=true output_path:=trash/ database_path:=map/map_tiny.db

