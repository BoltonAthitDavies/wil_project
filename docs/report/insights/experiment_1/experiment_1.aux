\@writefile{lot}{\contentsline {table}{\numberline {1.10}{\ignorespaces Visual estimators against the optical-tracker ground truth on the real \texttt  {dataset_realv3_000} recording. Planar ATE after rigid $SE(2)$ alignment with scale fixed at one, evaluated at the tracker's own samples ($n$); the time offset between the unsynchronised robot clock and the tracker is estimated from wheel-speed correlation (\cref  {sec:method-trajectory}). Translational RPE at $\Delta =\SI {1}{\second }$ compares relative displacements in the aligned frame; the tracker has no heading, so rotational RPE is not defined. ``Path'' is the estimate's planar path length over the matched interval divided by the tracker's. The marker-to-sensor lever arm is not measured (horizontal offset assumed zero), so every value is provisional. Failed runs (\texttt  {dataset_realv3_000} VINS-Fusion) are excluded and reported in the text. Lower is better.\relax }}{9}{table.caption.25}\protected@file@percent }
\newlabel{tab:real-gt-ate}{{1.10}{9}{Visual estimators against the optical-tracker ground truth on the real \repo {dataset_realv3_000} recording. Planar ATE after rigid $SE(2)$ alignment with scale fixed at one, evaluated at the tracker's own samples ($n$); the time offset between the unsynchronised robot clock and the tracker is estimated from wheel-speed correlation (\cref {sec:method-trajectory}). Translational RPE at $\Delta =\SI {1}{\second }$ compares relative displacements in the aligned frame; the tracker has no heading, so rotational RPE is not defined. ``Path'' is the estimate's planar path length over the matched interval divided by the tracker's. The marker-to-sensor lever arm is not measured (horizontal offset assumed zero), so every value is provisional. Failed runs (\repo {dataset_realv3_000} VINS-Fusion) are excluded and reported in the text. Lower is better.\relax }{table.caption.25}{}}
\newlabel{tab:real-gt-ate@cref}{{[table][10][4]1.10}{[1][9][]9}}
\@writefile{lot}{\contentsline {table}{\numberline {1.11}{\ignorespaces Translational RPE sweep on the real recordings, RMSE over all admissible pairs (realised separation within \SI {25}{\percent } of $\Delta $), relative displacements compared in the aligned frame. Pair counts in parentheses. Failed runs excluded.\relax }}{9}{table.caption.26}\protected@file@percent }
\newlabel{tab:real-gt-rpe}{{1.11}{9}{Translational RPE sweep on the real recordings, RMSE over all admissible pairs (realised separation within \SI {25}{\percent } of $\Delta $), relative displacements compared in the aligned frame. Pair counts in parentheses. Failed runs excluded.\relax }{table.caption.26}{}}
\newlabel{tab:real-gt-rpe@cref}{{[table][11][4]1.11}{[1][9][]9}}
\@writefile{toc}{\contentsline {paragraph}{Analysis.}{9}{section*.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Real-robot estimates against the optical tracker on \texttt  {dataset_realv3_000}. Left: the two ORB-SLAM3 runs after rigid planar alignment with scale fixed; the tracker (black) traces a loop about \SI {2}{\metre } across and both estimates a smaller loop inside it. Right: planar error and speed on the robot-clock timeline; the tracker's speed is drawn shifted by the fitted offset, and VINS-Fusion's speed rises without bound from \SI {10}{\second } while the robot moves at \SI {0.2}{\metre \per \second }. No site plan exists for the real floor, so no map underlay is drawn.\relax }}{10}{figure.caption.27}\protected@file@percent }
\newlabel{fig:e1-real}{{1.3}{10}{Real-robot estimates against the optical tracker on \repo {dataset_realv3_000}. Left: the two ORB-SLAM3 runs after rigid planar alignment with scale fixed; the tracker (black) traces a loop about \SI {2}{\metre } across and both estimates a smaller loop inside it. Right: planar error and speed on the robot-clock timeline; the tracker's speed is drawn shifted by the fitted offset, and VINS-Fusion's speed rises without bound from \SI {10}{\second } while the robot moves at \SI {0.2}{\metre \per \second }. No site plan exists for the real floor, so no map underlay is drawn.\relax }{figure.caption.27}{}}
\newlabel{fig:e1-real@cref}{{[figure][3][4]1.3}{[1][9][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces The same alignment with the failed VINS-Fusion run included: its \SI {60}{\metre } path reduces the \SI {2}{\metre } loop to a dot, which is why it is omitted from \cref  {fig:e1-real}.\relax }}{10}{figure.caption.28}\protected@file@percent }
\newlabel{fig:e1-real-all}{{1.4}{10}{The same alignment with the failed VINS-Fusion run included: its \SI {60}{\metre } path reduces the \SI {2}{\metre } loop to a dot, which is why it is omitted from \cref {fig:e1-real}.\relax }{figure.caption.28}{}}
\newlabel{fig:e1-real-all@cref}{{[figure][4][4]1.4}{[1][9][]10}}
