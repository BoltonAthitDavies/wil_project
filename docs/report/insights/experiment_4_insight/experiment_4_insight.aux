\newlabel{tab:insight4nav-rotation}{{I.1}{2}{Heading error against ground truth, degrees. The first sample after the first fix is excluded: it carries the correction still settling and held both runs' apparent 160-degree maxima. ``In exc.'' is the median while the position error is over \SI {1}{\metre }, ``out'' while it is not, and $r$ their correlation.\relax }{table.caption.4}{}}
\newlabel{tab:insight4nav-rotation@cref}{{[table][1][4]I.1}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.1}{\ignorespaces Left: heading error per run, median and 95th percentile. The three U-layout runs sit under \SI {0.5}{\degree }; the three I-layout runs are three to six times that. Right: heading error while turning against heading error while driving straight. The points fall either side of the diagonal rather than along it, so there is no consistent turn-rate effect and whatever sets the level is not the motion.\relax }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:insight4nav-rotation}{{I.1}{2}{Left: heading error per run, median and 95th percentile. The three U-layout runs sit under \SI {0.5}{\degree }; the three I-layout runs are three to six times that. Right: heading error while turning against heading error while driving straight. The points fall either side of the diagonal rather than along it, so there is no consistent turn-rate effect and whatever sets the level is not the motion.\relax }{figure.caption.5}{}}
\newlabel{fig:insight4nav-rotation@cref}{{[figure][1][4]I.1}{[1][1][]2}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Insight 2: the one excursion is a refused correction, not a wrong one}{3}{section.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I.2}{\ignorespaces The two excursions, and the correction that produced each. Yaw in degrees, $x$ in metres.\relax }}{3}{table.caption.6}\protected@file@percent }
\newlabel{tab:insight4nav-exc}{{I.2}{3}{The two excursions, and the correction that produced each. Yaw in degrees, $x$ in metres.\relax }{table.caption.6}{}}
\newlabel{tab:insight4nav-exc@cref}{{[table][2][4]I.2}{[1][3][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.2}{\ignorespaces The one excursion, shaded where the position error exceeds \SI {1}{\metre }. Top: position error with heading error on the right axis. Bottom: the \texttt  {map}\nobreakspace  {}$\rightarrow $\nobreakspace  {}\texttt  {odom} correction in yaw and in translation. Neither moves across the stretch, which is the point --- the pose was not placed somewhere wrong, it was left where dead reckoning put it because the gate refused the corrections on offer.\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:insight4nav-exc}{{I.2}{4}{The one excursion, shaded where the position error exceeds \SI {1}{\metre }. Top: position error with heading error on the right axis. Bottom: the \texttt {map}~$\rightarrow $~\texttt {odom} correction in yaw and in translation. Neither moves across the stretch, which is the point --- the pose was not placed somewhere wrong, it was left where dead reckoning put it because the gate refused the corrections on offer.\relax }{figure.caption.7}{}}
\newlabel{fig:insight4nav-exc@cref}{{[figure][2][4]I.2}{[1][3][]4}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Insight 3: over these distances the prior supplies a datum, not accuracy}{5}{section.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I.3}{\ignorespaces The localised pose against unaided ORB-SLAM3 over the same run, metres. The front end is rigidly aligned to ground truth first, so its column is DRIFT alone with the unknown initial pose given away free -- the kindest possible reading of odometry, and the one thing the prior actually supplies.\relax }}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:insight4nav-prior}{{I.3}{5}{The localised pose against unaided ORB-SLAM3 over the same run, metres. The front end is rigidly aligned to ground truth first, so its column is DRIFT alone with the unknown initial pose given away free -- the kindest possible reading of odometry, and the one thing the prior actually supplies.\relax }{table.caption.8}{}}
\newlabel{tab:insight4nav-prior@cref}{{[table][3][4]I.3}{[1][5][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.3}{\ignorespaces Left: each run's median error, unaided front end against localised pose, joined; green where the prior helps, orange where it hurts. It helps on four of six, and the two it loses are the two shortest routes. Right: the same medians as bars with each column's worst instant as a tick, logarithmic. The front end never exceeds \SI {0.64}{\metre }; the localised pose reaches \SI {1.24}{\metre }.\relax }}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:insight4nav-prior}{{I.3}{5}{Left: each run's median error, unaided front end against localised pose, joined; green where the prior helps, orange where it hurts. It helps on four of six, and the two it loses are the two shortest routes. Right: the same medians as bars with each column's worst instant as a tick, logarithmic. The front end never exceeds \SI {0.64}{\metre }; the localised pose reaches \SI {1.24}{\metre }.\relax }{figure.caption.9}{}}
\newlabel{fig:insight4nav-prior@cref}{{[figure][3][4]I.3}{[1][5][]5}}
