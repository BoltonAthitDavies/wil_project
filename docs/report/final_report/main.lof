\contentsline {figure}{\numberline {2.4}{\ignorespaces The indirect (feature-based) method common to SLAM systems: a front end producing pseudo-measurements and loop-closure constraints, and a back end performing geometric SLAM by factor-graph optimisation\nobreakspace {}\cite {cadena2016}.\relax }}{6}{figure.caption.14}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Main components of ORB-SLAM3: the tracking, local mapping and loop and map-merging threads around the Atlas multi-map representation and the DBoW2 keyframe database\nobreakspace {}\cite {campos2021}.\relax }}{7}{figure.caption.15}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Main components of monocular VINS: measurement preprocessing, initialisation, sliding-window visual-inertial odometry with relocalization, and global pose-graph optimisation and reuse\nobreakspace {}\cite {qin2018vins}.\relax }}{8}{figure.caption.19}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Main components of RTAB-Map: sensor synchronisation, short-term and working memory, long-term memory, loop-closure and proximity detection, graph optimisation and global map assembly\nobreakspace {}\cite {labbe2019}.\relax }}{10}{figure.caption.25}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Architecture of RY-SLAM: a YOLOv8-seg dynamic-object detection stage feeding a semantic mask into the ORB-SLAM3 tracking thread ahead of the Atlas multi-map system\nobreakspace {}\cite {chen2025}.\relax }}{14}{figure.caption.30}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Detail of the semantic-segmentation framework in RY-SLAM and its multi-threaded operation: ONNX Runtime inference producing the dynamic mask, the neighbourhood test that deletes feature points, and the viewer outputs\nobreakspace {}\cite {chen2025}.}}{14}{figure.caption.31}%
