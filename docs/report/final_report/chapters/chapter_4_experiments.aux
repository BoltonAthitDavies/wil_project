\@writefile{lot}{\contentsline {table}{\numberline {4.10}{\ignorespaces Visual estimators against the optical-tracker ground truth on the real \repo {dataset_realv3_000} recording. Planar ATE after rigid $SE(2)$ alignment with scale fixed at one, evaluated at the tracker's own samples ($n$); the time offset between the unsynchronised robot clock and the tracker is estimated from wheel-speed correlation (\cref  {sec:method-trajectory}). Translational RPE at $\Delta =\SI {1}{\second }$ compares relative displacements in the aligned frame; the tracker has no heading, so rotational RPE is not defined. ``Path'' is the estimate's planar path length over the matched interval divided by the tracker's. The marker-to-sensor lever arm is not measured (horizontal offset assumed zero), so every value is provisional. Failed runs (\repo {dataset_realv3_000} VINS-Fusion) are excluded and reported in the text. Lower is better.\relax }}{77}{table.caption.132}\protected@file@percent }
\newlabel{tab:real-gt-ate}{{4.10}{77}{Visual estimators against the optical-tracker ground truth on the real \repo {dataset_realv3_000} recording. Planar ATE after rigid $SE(2)$ alignment with scale fixed at one, evaluated at the tracker's own samples ($n$); the time offset between the unsynchronised robot clock and the tracker is estimated from wheel-speed correlation (\cref {sec:method-trajectory}). Translational RPE at $\Delta =\SI {1}{\second }$ compares relative displacements in the aligned frame; the tracker has no heading, so rotational RPE is not defined. ``Path'' is the estimate's planar path length over the matched interval divided by the tracker's. The marker-to-sensor lever arm is not measured (horizontal offset assumed zero), so every value is provisional. Failed runs (\repo {dataset_realv3_000} VINS-Fusion) are excluded and reported in the text. Lower is better.\relax }{table.caption.132}{}}
\newlabel{tab:real-gt-ate@cref}{{[table][10][4]4.10}{[1][77][]77}}
