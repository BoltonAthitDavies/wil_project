\newlabel{sec:exp4-allruns@cref}{{[section][2][4]4.4.2}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces \texttt  {U\_static}, straight, \SI {24.6}{\metre }. The two tracks are indistinguishable at this scale, which is the point: the median error is \SI {0.162}{\metre } and the run never crossed a metre. It is also the figure that exposed the lever-arm error --- a \SI {0.47}{\metre } offset was being reported for a run whose tracks visibly coincide, which is only possible if the offset lies along the direction of travel, where a path plot cannot show it.\relax }}{8}{figure.caption.22}\protected@file@percent }
\newlabel{fig:exp4-u-straight}{{4.6}{8}{\texttt {U\_static}, straight, \SI {24.6}{\metre }. The two tracks are indistinguishable at this scale, which is the point: the median error is \SI {0.162}{\metre } and the run never crossed a metre. It is also the figure that exposed the lever-arm error --- a \SI {0.47}{\metre } offset was being reported for a run whose tracks visibly coincide, which is only possible if the offset lies along the direction of travel, where a path plot cannot show it.\relax }{figure.caption.22}{}}
\newlabel{fig:exp4-u-straight@cref}{{[figure][6][4]4.6}{[1][7][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces \texttt  {I\_static}, straight, \SI {20.9}{\metre }: the most accurate run of the seven by median (\SI {0.097}{\metre }) and the least available, with \SI {15.8}{\percent } of its poses carrying no information. Accuracy and availability are separate properties and this run holds the extreme of both.\relax }}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:exp4-i-straight}{{4.7}{8}{\texttt {I\_static}, straight, \SI {20.9}{\metre }: the most accurate run of the seven by median (\SI {0.097}{\metre }) and the least available, with \SI {15.8}{\percent } of its poses carrying no information. Accuracy and availability are separate properties and this run holds the extreme of both.\relax }{figure.caption.23}{}}
\newlabel{fig:exp4-i-straight@cref}{{[figure][7][4]4.7}{[1][7][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces \texttt  {I\_static}, approximately square, \SI {66.8}{\metre }: the largest median of the seven at \SI {0.361}{\metre }, with no excursion over a metre and an offset of \SI {0.204}{\metre }. A consistently displaced pose rather than an unstable one, and the case that sets the upper end of the \SIrange {0.10}{0.36}{\metre } range.\relax }}{9}{figure.caption.24}\protected@file@percent }
\newlabel{fig:exp4-i-square}{{4.8}{9}{\texttt {I\_static}, approximately square, \SI {66.8}{\metre }: the largest median of the seven at \SI {0.361}{\metre }, with no excursion over a metre and an offset of \SI {0.204}{\metre }. A consistently displaced pose rather than an unstable one, and the case that sets the upper end of the \SIrange {0.10}{0.36}{\metre } range.\relax }{figure.caption.24}{}}
\newlabel{fig:exp4-i-square@cref}{{[figure][8][4]4.8}{[1][7][]9}}
