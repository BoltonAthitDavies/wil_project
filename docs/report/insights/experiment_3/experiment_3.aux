\@writefile{lot}{\contentsline {table}{\numberline {3.9}{\ignorespaces Unfiltered arms on the four realistic-warehouse recordings, 21 October 2026, replay rate 1.0. Aligned ATE is RMSE after a rigid $SE(3)$ fit with scale fixed; RPE is translational, at $\Delta =\SI {1}{\second }$ over pairs that do not span a jump; ``Jumps'' counts steps above \SI {10}{\metre \per \second }; ``Kept'' is the fraction of the bag's stereo pairs the estimator processed (frames lost before the node's own queue count as lost). Loop-closer state is read from \texttt  {loop_closing.csv}, not from the run name. Static and dynamic rows of one layout share a world geometry and differ in traffic only.\relax }}{20}{table.caption.38}\protected@file@percent }
\newlabel{tab:realistic-baseline}{{3.9}{20}{Unfiltered arms on the four realistic-warehouse recordings, 21 October 2026, replay rate 1.0. Aligned ATE is RMSE after a rigid $SE(3)$ fit with scale fixed; RPE is translational, at $\Delta =\SI {1}{\second }$ over pairs that do not span a jump; ``Jumps'' counts steps above \SI {10}{\metre \per \second }; ``Kept'' is the fraction of the bag's stereo pairs the estimator processed (frames lost before the node's own queue count as lost). Loop-closer state is read from \repo {loop_closing.csv}, not from the run name. Static and dynamic rows of one layout share a world geometry and differ in traffic only.\relax }{table.caption.38}{}}
\newlabel{tab:realistic-baseline@cref}{{[table][9][4]3.9}{[1][19][]20}}
