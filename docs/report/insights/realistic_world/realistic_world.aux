\@writefile{lof}{\contentsline {figure}{\numberline {R.2}{\ignorespaces Plan of the I-shape world, same conventions. Receiving docks on the north wall, dispatch docks on the south wall; the recorded teleop route (grey) crosses the storage racks here and is not drivable in this layout, which is why the I-shape recordings use a new route.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:plan-i}{{R.2}{4}{Plan of the I-shape world, same conventions. Receiving docks on the north wall, dispatch docks on the south wall; the recorded teleop route (grey) crosses the storage racks here and is not drivable in this layout, which is why the I-shape recordings use a new route.\relax }{figure.caption.2}{}}
\newlabel{fig:plan-i@cref}{{[figure][2][0]R.2}{[1][2][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {R.3}{\ignorespaces Baked occupancy truth of the two worlds: \SI {42.2}{\metre } square at \SI {0.05}{\metre } per cell, origin $(-21.1,-21.1)$\nobreakspace  {}m. Carriers and loads are baked at their $t=0$ pose, where the static twin holds them permanently. Closed dock doors are the one-cell segments in the wall; open doors are the gaps.\relax }}{5}{figure.caption.4}\protected@file@percent }
