\newlabel{tab:orb-params}{{3.15}{20}{ORB-SLAM3 configuration at the cutoff. Wrapper values are from \repo {orbslam3_ros2/src/}; extractor and IMU values from \repo {config/wil_sim/stereo_imu.yaml}. Noise densities are given in \cref {tab:imu-noise-assumed} and are not repeated here}{table.3.15}{}}
