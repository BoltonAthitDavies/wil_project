\@writefile{toc}{\contentsline {section}{\numberline {2}Insight 1: heading is accurate, and traffic is what degrades it}{1}{section.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I.1}{\ignorespaces Heading error against ground truth, degrees. The first sample after the first fix is excluded: it carries the correction still settling and held both runs' apparent 160-degree maxima. ``In exc.'' is the median while the position error is over \SI {1}{\metre }, ``out'' while it is not, and $r$ their correlation.\relax }}{2}{table.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:insight4nav-rotation}{{I.1}{2}{Heading error against ground truth, degrees. The first sample after the first fix is excluded: it carries the correction still settling and held both runs' apparent 160-degree maxima. ``In exc.'' is the median while the position error is over \SI {1}{\metre }, ``out'' while it is not, and $r$ their correlation.\relax }{table.caption.4}{}}
\newlabel{tab:insight4nav-rotation@cref}{{[table][1][4]I.1}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.1}{\ignorespaces Left: heading error per run, median and 95th percentile, the run with traffic in orange. Every static run sits under \SI {1.2}{\degree } median and the dynamic one at \SI {4.85}{\degree }; the gap is the finding, not the level. Right: heading error while turning against heading error while driving straight. The points sit on the diagonal, so whatever sets the floor is not the motion.\relax }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:insight4nav-rotation}{{I.1}{2}{Left: heading error per run, median and 95th percentile, the run with traffic in orange. Every static run sits under \SI {1.2}{\degree } median and the dynamic one at \SI {4.85}{\degree }; the gap is the finding, not the level. Right: heading error while turning against heading error while driving straight. The points sit on the diagonal, so whatever sets the floor is not the motion.\relax }{figure.caption.5}{}}
\newlabel{fig:insight4nav-rotation@cref}{{[figure][1][4]I.1}{[1][1][]2}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Insight 2: the two excursions are two different faults}{3}{section.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I.2}{\ignorespaces The two excursions, and the correction that produced each. Yaw in degrees, $x$ in metres.\relax }}{3}{table.caption.6}\protected@file@percent }
\newlabel{tab:insight4nav-exc}{{I.2}{3}{The two excursions, and the correction that produced each. Yaw in degrees, $x$ in metres.\relax }{table.caption.6}{}}
\newlabel{tab:insight4nav-exc@cref}{{[table][2][4]I.2}{[1][3][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.2}{\ignorespaces The two excursions, shaded where the position error exceeds \SI {1}{\metre }. Top row: position error with heading error on the right axis. Bottom row: the \texttt  {map}\nobreakspace  {}$\rightarrow $\nobreakspace  {}\texttt  {odom} correction in yaw and in translation. \leavevmode {\color  {flagred}Both excursions move the correction in both quantities, so the corrections alone do not separate them} --- the heading error does. On the figure-of-eight it rises with the position error and stays up for the whole \SI {23}{\second }; on the square it spikes once at the transition and falls back to about \SI {2}{\degree } while the position error holds at \SI {6}{\metre } for \SI {35}{\second }. A persistent heading error is a wrong orientation; a transient one is the pose being moved.\relax }}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:insight4nav-exc}{{I.2}{3}{The two excursions, shaded where the position error exceeds \SI {1}{\metre }. Top row: position error with heading error on the right axis. Bottom row: the \texttt {map}~$\rightarrow $~\texttt {odom} correction in yaw and in translation. \flag {Both excursions move the correction in both quantities, so the corrections alone do not separate them} --- the heading error does. On the figure-of-eight it rises with the position error and stays up for the whole \SI {23}{\second }; on the square it spikes once at the transition and falls back to about \SI {2}{\degree } while the position error holds at \SI {6}{\metre } for \SI {35}{\second }. A persistent heading error is a wrong orientation; a transient one is the pose being moved.\relax }{figure.caption.7}{}}
\newlabel{fig:insight4nav-exc@cref}{{[figure][2][4]I.2}{[1][3][]3}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Insight 3: over these distances the prior supplies a datum, not accuracy}{4}{section.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I.3}{\ignorespaces The localised pose against unaided ORB-SLAM3 over the same run, metres. The front end is rigidly aligned to ground truth first, so its column is DRIFT alone with the unknown initial pose given away free -- the kindest possible reading of odometry, and the one thing the prior actually supplies.\relax }}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:insight4nav-prior}{{I.3}{4}{The localised pose against unaided ORB-SLAM3 over the same run, metres. The front end is rigidly aligned to ground truth first, so its column is DRIFT alone with the unknown initial pose given away free -- the kindest possible reading of odometry, and the one thing the prior actually supplies.\relax }{table.caption.8}{}}
\newlabel{tab:insight4nav-prior@cref}{{[table][3][4]I.3}{[1][4][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.3}{\ignorespaces Left: each run's median error, unaided front end against localised pose, joined; green where the prior helps, orange where it hurts. They split three to three with one level. Right: the same medians as bars with each column's worst instant as a tick, logarithmic. The front end never exceeds \SI {0.76}{\metre }; the localised pose reaches \SI {6.80}{\metre }. The asymmetry on the right, not the split on the left, is what the prior costs over these distances.\relax }}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:insight4nav-prior}{{I.3}{4}{Left: each run's median error, unaided front end against localised pose, joined; green where the prior helps, orange where it hurts. They split three to three with one level. Right: the same medians as bars with each column's worst instant as a tick, logarithmic. The front end never exceeds \SI {0.76}{\metre }; the localised pose reaches \SI {6.80}{\metre }. The asymmetry on the right, not the split on the left, is what the prior costs over these distances.\relax }{figure.caption.9}{}}
\newlabel{fig:insight4nav-prior@cref}{{[figure][3][4]I.3}{[1][4][]4}}
