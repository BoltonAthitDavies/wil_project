\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Baked occupancy truth of the three large-warehouse object arrangements, each \SI {42.2}{\metre } square at \SI {0.05}{\metre } per cell with origin $(-21.1,-21.1)$\nobreakspace  {}m. Black is occupied, white is free; there is no unknown space because the grids are rasterised from collision geometry rather than observed. Occupied cells are \SI {17.79}{\percent } of\nobreakspace  {}(a), \SI {8.74}{\percent } of\nobreakspace  {}(b) and \SI {10.98}{\percent } of\nobreakspace  {}(c). Panel\nobreakspace  {}(b) clears the central floor and keeps obstacles against the walls, which is the arrangement used by \repo {dataset_allsensor_002} and \repo {dataset_allsensor_003}. \emph  {No occupancy grid is shown per floor treatment, and none exists:} the \texttt  {bayline} and plain floors differ only in surface material, which carries no collision geometry, so their baked grids are identical to the panels above. See \cref  {fig:floor-treatments}.}}{13}{figure.3.4}\protected@file@percent }
\newlabel{fig:warehouse-maps}{{3.4}{13}{Baked occupancy truth of the three large-warehouse object arrangements, each \SI {42.2}{\metre } square at \SI {0.05}{\metre } per cell with origin $(-21.1,-21.1)$~m. Black is occupied, white is free; there is no unknown space because the grids are rasterised from collision geometry rather than observed. Occupied cells are \SI {17.79}{\percent } of~(a), \SI {8.74}{\percent } of~(b) and \SI {10.98}{\percent } of~(c). Panel~(b) clears the central floor and keeps obstacles against the walls, which is the arrangement used by \repo {dataset_allsensor_002} and \repo {dataset_allsensor_003}. \emph {No occupancy grid is shown per floor treatment, and none exists:} the \texttt {bayline} and plain floors differ only in surface material, which carries no collision geometry, so their baked grids are identical to the panels above. See \cref {fig:floor-treatments}}{figure.3.4}{}}
\newlabel{fig:warehouse-maps@cref}{{[figure][4][3]3.4}{[1][12][]13}}
\@writefile{lot}{\contentsline {table}{\numberline {3.11}{\ignorespaces Ground models and the floor conditions they produce. The mesh and its collision geometry are identical in all three, so the floor treatment changes what a camera sees and nothing a wheel, an occupancy grid or a collision check responds to. The concrete-grain texture belongs to the stock model only, and no recorded dataset uses it.}}{13}{table.3.11}\protected@file@percent }
\newlabel{tab:floor-variants}{{3.11}{13}{Ground models and the floor conditions they produce. The mesh and its collision geometry are identical in all three, so the floor treatment changes what a camera sees and nothing a wheel, an occupancy grid or a collision check responds to. The concrete-grain texture belongs to the stock model only, and no recorded dataset uses it}{table.3.11}{}}
\newlabel{tab:floor-variants@cref}{{[table][11][3]3.11}{[1][13][]13}}
\@writefile{lot}{\contentsline {table}{\numberline {3.12}{\ignorespaces What each dataset contains. ``Objects'' counts obstacle instances whose collision geometry intersects the robot-height band, excluding the wall ring. ``Route'' is the ground-truth path length and ``sim span'' its duration in simulated time. The world column drops the floor suffix, which is given separately, so two rows sharing a world arrangement but differing in floor are visible as such.}}{14}{table.3.12}\protected@file@percent }
\newlabel{tab:dataset-scenes}{{3.12}{14}{What each dataset contains. ``Objects'' counts obstacle instances whose collision geometry intersects the robot-height band, excluding the wall ring. ``Route'' is the ground-truth path length and ``sim span'' its duration in simulated time. The world column drops the floor suffix, which is given separately, so two rows sharing a world arrangement but differing in floor are visible as such}{table.3.12}{}}
\newlabel{tab:dataset-scenes@cref}{{[table][12][3]3.12}{[1][13][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces The two recorded floor conditions, rendered across the full \SI {42.2}{\metre } floor at \SI {0.05}{\metre } per pixel. Both share the same flat diffuse base, RGB $(0.814,0.811,0.804)$; the only difference between them is the 112 painted marking faces that \texttt  {bayline} adds, forming the hazard-striped outlines of fourteen storage bays. Panel\nobreakspace  {}(c) is a \SI {12}{\metre } square detail showing the strips at \SI {0.145}{\metre } width. Everything not outlined is untextured in both conditions.}}{15}{figure.3.5}\protected@file@percent }
\newlabel{fig:floor-treatments}{{3.5}{15}{The two recorded floor conditions, rendered across the full \SI {42.2}{\metre } floor at \SI {0.05}{\metre } per pixel. Both share the same flat diffuse base, RGB $(0.814,0.811,0.804)$; the only difference between them is the 112 painted marking faces that \texttt {bayline} adds, forming the hazard-striped outlines of fourteen storage bays. Panel~(c) is a \SI {12}{\metre } square detail showing the strips at \SI {0.145}{\metre } width. Everything not outlined is untextured in both conditions}{figure.3.5}{}}
\newlabel{fig:floor-treatments@cref}{{[figure][5][3]3.5}{[1][12][]15}}
